{
  "name": "whatboutme",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "postinstall": "cd apps/api && npx prisma generate --schema=prisma/schema.prisma",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "optimize:assets": "node scripts/optimize-assets.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "glob": "^13.0.6"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "prisma@6.19.3": true,
    "@prisma/client@5.22.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.16.13": true
  }
}
