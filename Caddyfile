:81 {
	# 1. Transparent high-ratio compression (Zstandard with Gzip fallback)
	encode zstd gzip

	# 2. Immutable long-term caching for content-hashed Next.js bundles and webfonts
	@immutable_assets {
		path /_next/static/* /fonts/*
	}
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

	# 3. 1-Day cache with 7-day stale-while-revalidate for brand logos and flyer images
	@brand_assets {
		path /brand/* /site/*
	}
	header @brand_assets Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# 4. Secure upstream port routing: restricted strictly to known web and API application ports
	@transform_port_3000 query XTransformPort=3000
	handle @transform_port_3000 {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}

	@transform_port_3001 query XTransformPort=3001
	handle @transform_port_3001 {
		reverse_proxy localhost:3001 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}

	@transform_port_3002 query XTransformPort=3002
	handle @transform_port_3002 {
		reverse_proxy localhost:3002 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}

	@transform_port_3003 query XTransformPort=3003
	handle @transform_port_3003 {
		reverse_proxy localhost:3003 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}

	@transform_port_4000 query XTransformPort=4000
	handle @transform_port_4000 {
		reverse_proxy localhost:4000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}

	# Block all unapproved port-forwarding attempts to prevent SSRF and internal port scanning
	@unauthorized_port query XTransformPort=*
	handle @unauthorized_port {
		respond "Forbidden upstream port" 403
	}

	# Default upstream handler: Marketing frontend (port 3001)
	handle {
		reverse_proxy localhost:3001 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
		}
	}
}
