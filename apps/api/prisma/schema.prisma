generator client {
  provider        = "prisma-client-js"
  // nested relations load in a single joined query instead of one query per
  // level; each query is a round trip to a distant database
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TEACHER
  USER
}

enum EnrolmentStatus {
  PENDING_PAYMENT
  PENDING_AGREEMENT
  ACTIVE
  WAITLIST
  COMPLETED
  REVOKED
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  SHORT_ANSWER
  SINGLE_CHOICE
  TEXT_BOX
}

enum OralAssessmentStatus {
  SCHEDULED
  IN_PROGRESS
  PASSED
  FAILED
  CANCELLED
}

enum ContentType {
  VIDEO
  PDF
  AUDIO
  TEXT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReleaseSchedule {
  IMMEDIATE
  BATCH_SCHEDULED
}

enum StepOverrideState {
  AUTOMATIC
  MANUAL_UNLOCKED
  MANUAL_LOCKED
}

enum QuizPlacement {
  BEFORE_VIDEO
  AFTER_VIDEO
}

enum ResourceType {
  VIEW_ONLY_PDF
  DOWNLOADABLE_WORKSHEET
  STREAMABLE_AUDIO
}

enum ResourceScope {
  STEP_SPECIFIC
  PROGRAM_LIBRARY
}

enum ResourceItemType {
  WORKSHEET
  READING
  GUIDED_AUDIO
  VIDEO
}

enum ResourceAccessScope {
  ALL_ENROLLED
  PROGRAM
  BATCH
  STEP_UNLOCKED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  ALL_COURSES
  SPECIFIC_COURSES
}

enum CouponCurrency {
  INR
  AED
  USD
  ALL
}

enum AgreementStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SessionType {
  WELCOME_CALL_11_STEPS
  CLOSING_CALL_11_STEPS
  ONE_ON_ONE_WITH_RO
  VISION_BOARD_WORKSHOP
  VISION_BOARD_ONLINE
  SPEAKER_DISCOVERY_CALL
  BATCH_CLASS
  GROUP_COHORT
  ONE_ON_ONE
}

enum MeetingProvider {
  ZOOM
  GOOGLE_MEET
  IN_PERSON
  MANUAL
}

enum BookingStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  ATTENDED
  NO_SHOW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  PENDING
  PRESENT_AUTO
  PRESENT_MANUAL
  CORRECTED
}

enum AttendanceSource {
  AUTO
  MANUAL
  QR_CHECKIN
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum CertificateType {
  PROFESSIONAL
  CORPORATE_PARTICIPATION
}

enum NotificationChannel {
  EMAIL
  IN_APP
  BOTH
  PUSH
  ALL
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  REOPENED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES (USERS & COMPANIES)
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  phone        String?
  passwordHash String?
  role         Role    @default(USER)
  permissions  String[] @default([])

  // Authentication & Security (D1-004)
  country              String?
  timezone             String?
  emailVerifiedAt      DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String[]  @default([])

  // Reusable Digital Signature (Requirement: Reusable Digital Signature in Learner Profile)
  savedSignature          String?
  savedSignatureType      String?   // "DRAWN" or "UPLOADED"
  savedSignatureUpdatedAt DateTime?

  // Notification Preferences (Task 13)
  notificationPreferences Json?

  // Relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  managedBatches               Batch[]                    @relation("ManagerBatches")
  batchTrainers                BatchTrainer[]             @relation("BatchTrainers")
  oralAssessmentsAssessed      OralAssessment[]           @relation("AssessorOralAssessments")
  signedAgreements             SignedAgreement[]
  createdAgreementVersions     AgreementTemplateVersion[] @relation("CreatedAgreementVersions")
  sessionBookings              SessionBooking[]           @relation("UserSessionBookings")
  attendedSessions             Attendance[]               @relation("UserAttendances")
  correctedAttendances         Attendance[]               @relation("CorrectedAttendances")
  resolvedUnmatchedAttendances UnmatchedAttendance[]      @relation("ResolvedUnmatchedAttendances")
  linkedUnmatchedAttendances   UnmatchedAttendance[]      @relation("LinkedUnmatchedAttendances")
  learnerSessions              Session[]                  @relation("Learner1on1Sessions")
  userSpecificSessions         Session[]                  @relation("UserSpecificSessions")
  hostedSessions               Session[]                  @relation("HostTrainerSessions")
  certificates                 Certificate[]              @relation("UserCertificates")
  approvedCertificates         Certificate[]              @relation("ApprovedCertificates")
  enrolments                   Enrolment[]
  messagesSent                 Message[]
  sessions                     UserSession[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  dailyAttendance              DailyAttendance[]
  emailVerificationTokens      EmailVerificationToken[]
  passwordResetTokens          PasswordResetToken[]
  otpCodes                     OtpCode[]
  loginAudits                  LoginAudit[]
  createdResourceItems         ResourceItem[]             @relation("CreatedResourceItems")
  couponRedemptions            CouponRedemption[]
  sentAnnouncements            BatchAnnouncement[]        @relation("SentAnnouncements")
  createdEvents                Event[]                    @relation("CreatedEvents")
  eventRegistrations           EventRegistration[]        @relation("UserEventRegistrations")
  rejectedEventRegistrations   EventRegistration[]        @relation("RejectedEventRegistrations")
  studentNotes                 StudentNote[]

  // Soft Delete for GDPR
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([companyId])
  @@index([role, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model UserSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token             String    @unique // Store the JWT or a session hash
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  lastActive        DateTime  @default(now())
  expiresAt         DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model LoginAudit {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress         String?
  userAgent         String?
  country           String?
  deviceFingerprint String?
  isSuspicious      Boolean  @default(false)
  reason            String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// CURRICULUM (PROGRAMS, STEPS, LESSONS, QUIZZES)
// -----------------------------------------------------------------------------

model Program {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  price       Float
  currency    CurrencyCode  @default(USD)
  priceUSD    Float?
  priceAED    Float?
  priceINR    Float?
  earlyBirdPrice    Float?
  earlyBirdCurrency CurrencyCode?
  earlyBirdDeadline DateTime?
  isActive    Boolean       @default(true)
  status      ContentStatus @default(DRAFT)

  hasCertificate          Boolean       @default(false)
  certificateTemplate     String?
  attendanceThreshold     Int           @default(80)
  attendanceRequired      Boolean       @default(true)
  minAttendancePercentage Int           @default(75)
  deliveryMode            DeliveryMode  @default(ONLINE)

  faqs                    Json?         @default("[]")

  steps              Step[]
  batches            Batch[]
  resources          Resource[]
  resourceItems      ResourceItem[]
  enrolments         Enrolment[]
  questionBanks      QuestionBank[]
  exams              Exam[]
  oralAssessments    OralAssessment[]
  agreementTemplates AgreementTemplate[]
  signedAgreements   SignedAgreement[]
  certificates       Certificate[]
  coupons            Coupon[]                   @relation("CouponPrograms")
  studentNotes       StudentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isActive, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([isActive])
}

model Step {
  id        String  @id @default(uuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  sequence    Int // 1 to 11
  title       String
  description String?
  status      ContentStatus @default(DRAFT)

  releaseSchedule ReleaseSchedule @default(IMMEDIATE)
  unlockDelayDays Int?
  quizPlacement   QuizPlacement   @default(AFTER_VIDEO)

  lessons       Lesson[]
  resources                Resource[]
  requiredForResourceItems ResourceItem[]
  quiz          Quiz?
  questionBanks QuestionBank[]
  questions     Question[]
  overrides     BatchStepOverride[]
  progress      StepProgress[]
  studentNotes  StudentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, sequence])
  @@index([programId, sequence])
  @@index([programId, status])
}

model Lesson {
  id     String @id @default(uuid())
  stepId String
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  title       String
  type        ContentType
  mediaUrl    String // AWS S3 / Mux Asset ID
  durationSec Int?
  content     String? // For TEXT content or lesson notes
  order       Int           @default(1)
  status      ContentStatus @default(DRAFT)

  progress UserLessonProgress[]
  studentNotes StudentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId, order])
  @@index([stepId, status])
}

// -----------------------------------------------------------------------------
// STUDENT NOTES & HIGHLIGHTS (TASK 6)
// -----------------------------------------------------------------------------

model StudentNote {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId             String?
  program               Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  stepId                String?
  step                  Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  lessonId              String?
  lesson                Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  noteText              String   @db.Text
  highlightSnippet      String?  @db.Text
  videoTimestampSeconds Int?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, lessonId])
  @@index([userId, stepId])
  @@index([userId, programId])
}

model Resource {
  id          String        @id @default(uuid())
  title       String
  description String?
  type        ResourceType
  scope       ResourceScope @default(STEP_SPECIFIC)
  mediaUrl    String // Cloudinary / Object Storage URL
  fileSize    Int? // File size in bytes
  mimeType    String? // MIME type e.g. application/pdf, audio/mpeg
  status      ContentStatus @default(PUBLISHED)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([stepId])
  @@index([batchId])
}

// -----------------------------------------------------------------------------
// STANDALONE RESOURCE LIBRARY (MODULE 1 OF 8)
// -----------------------------------------------------------------------------

model ResourceCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ResourceItem[]

  @@index([order])
}

model ResourceItem {
  id              String              @id @default(uuid())
  title           String
  description     String?
  type            ResourceItemType
  categoryId      String
  category        ResourceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  storageKey      String
  mimeType        String
  fileSizeBytes   Int
  durationSeconds Int?
  pageCount       Int?

  // Tagging & Access Scoping
  stepTagNumber   Int?
  accessScope     ResourceAccessScope @default(ALL_ENROLLED)
  programId       String?
  program         Program?            @relation(fields: [programId], references: [id], onDelete: Cascade)
  batchId         String?
  batch           Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  requiredStepId  String?
  requiredStep    Step?               @relation(fields: [requiredStepId], references: [id], onDelete: SetNull)

  isPublished     Boolean             @default(true)
  createdById     String?
  createdBy       User?               @relation("CreatedResourceItems", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([categoryId])
  @@index([accessScope])
  @@index([programId])
  @@index([batchId])
  @@index([requiredStepId])
  @@index([stepTagNumber])
  @@index([isPublished])
  @@index([createdById])
}

// -----------------------------------------------------------------------------
// ASSESSMENTS (QUESTION BANKS, QUIZZES, EXAMS, ORAL ASSESSMENTS)
// -----------------------------------------------------------------------------

model QuestionBank {
  id          String  @id @default(uuid())
  title       String
  description String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([stepId])
}

model Question {
  id            String       @id @default(uuid())
  type          QuestionType @default(MULTIPLE_CHOICE)
  text          String
  imageUrl      String?
  gradingMode   String?      @default("SELF_REFLECTION_AUTO_PASS")
  minCharacters Int?         @default(10)
  explanation   String?
  points        Int          @default(1)

  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)

  quizId String?
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  options Option[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionBankId])
  @@index([quizId])
  @@index([stepId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  imageUrl  String?
  isCorrect Boolean  @default(false)
  order     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model Quiz {
  id     String @id @default(uuid())
  stepId String @unique
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  title         String?
  passMark      Int     @default(75) // Percentage required to pass
  maxAttempts   Int     @default(3) // Throttling / retry limit
  cooldownHours Int     @default(24) // Wait between retries
  questionCount Int     @default(10) // 10-question step quiz requirement
  timeLimitMin  Int?
  retryGuidance String?
  quizPlacement QuizPlacement @default(AFTER_VIDEO)

  questions Question[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id          String  @id @default(uuid())
  title       String
  description String?
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  questionCount    Int           @default(50) // 50 questions pooled from question bank
  passMark         Int           @default(75) // Percentage required to pass
  timeLimitMin     Int           @default(90) // Configurable default: 90 minutes
  shuffleQuestions Boolean       @default(true)
  maxAttempts      Int           @default(3)
  cooldownHours    Int           @default(24)
  retryGuidance    String?
  status           ContentStatus @default(DRAFT)

  attempts ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model ExamAttempt {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Restrict)

  attemptNumber Int           @default(1)
  score         Int?
  passed        Boolean?
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  answers       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, examId, attemptNumber])
  @@index([enrolmentId, examId])
  @@index([examId, status])
}

model OralAssessment {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  programId   String
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  sessionId     String?
  assessorId    String?
  assessor      User?                @relation("AssessorOralAssessments", fields: [assessorId], references: [id], onDelete: SetNull)
  status        OralAssessmentStatus @default(SCHEDULED)
  overallScore  Int?
  passed        Boolean?
  scheduledDate DateTime?
  completedAt   DateTime?
  trainerNotes  String?
  retryGuidance String?

  scores OralAssessmentScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrolmentId])
  @@index([programId])
  @@index([assessorId])
}

model OralAssessmentScore {
  id             String         @id @default(uuid())
  assessmentId   String
  assessment     OralAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  rubricCategory String
  score          Int
  maxScore       Int            @default(10)
  feedback       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
}

// -----------------------------------------------------------------------------
// ENROLMENT & BATCH MANAGEMENT
// -----------------------------------------------------------------------------

model Batch {
  id        String  @id @default(uuid())
  name      String
  programId String
  program   Program @relation(fields: [programId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerBatches", fields: [managerId], references: [id])

  startDate           DateTime
  endDate             DateTime?
  capacity            Int
  status              BatchStatus @default(UPCOMING)
  attendanceThreshold Int?

  price               Float?
  currency            CurrencyCode?
  priceUSD            Float?
  priceAED            Float?
  priceINR            Float?
  earlyBirdPrice      Float?
  earlyBirdDeadline   DateTime?

  enrolments    Enrolment[]
  sessions      Session[]
  overrides     BatchStepOverride[]
  trainers      BatchTrainer[]
  resources     Resource[]
  resourceItems ResourceItem[]
  conversations Conversation[]
  announcements BatchAnnouncement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId, status])
  @@index([managerId, status])
  @@index([status, startDate(sort: Desc)])
  @@index([startDate(sort: Desc)])
  @@index([programId])
  @@index([managerId])
}

model BatchTrainer {
  id        String @id @default(uuid())
  batchId   String
  batch     Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User   @relation("BatchTrainers", fields: [trainerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([batchId, trainerId])
  @@index([trainerId])
  @@index([batchId])
}

model Enrolment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  status EnrolmentStatus @default(PENDING_PAYMENT)

  signedAgreement SignedAgreement?

  attempts             Attempt[]
  examAttempts         ExamAttempt[]
  oralAssessments      OralAssessment[]
  lessonProgress       UserLessonProgress[]
  attendance           Attendance[]
  unmatchedAttendances UnmatchedAttendance[]
  sessionBookings      SessionBooking[]
  certificate          Certificate?
  payments             Payment[]
  stepProgress         StepProgress[]
  couponRedemptions    CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
  @@unique([userId, batchId])
  @@index([userId, status])
  @@index([batchId, status])
  @@index([createdAt(sort: Desc)])
  @@index([batchId, createdAt(sort: Desc)])
  @@index([programId, status])
  @@index([userId])
  @@index([batchId])
  @@index([programId])
}

// -----------------------------------------------------------------------------
// PROGRESSION TRACKING & LOGIC GATES
// -----------------------------------------------------------------------------

// TRD 2.2: Tracks video view logic
model UserLessonProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  viewed          Boolean   @default(false)
  progressPercent Float     @default(0)
  lastPositionSec Float?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, lessonId])
  @@index([enrolmentId, viewed])
  @@index([lessonId])
}

// TRD 2.2: The attempt state machine for Quizzes
model Attempt {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Restrict)

  attemptNumber Int           @default(1)
  score         Int?
  passed        Boolean?
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, quizId, attemptNumber])
  @@index([enrolmentId, quizId])
  @@index([quizId, status])
  @@index([enrolmentId, status])
}

model QuizAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  selectedOptionId  String?
  selectedOptionIds String[] @default([])
  textAnswer        String?
  isCorrect         Boolean  @default(false)
  pointsAwarded     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// TRD 2.2: Admin override logic for locking/unlocking steps manually
model BatchStepOverride {
  id      String @id @default(uuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stepId  String
  step    Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  isUnlocked Boolean   @default(false)
  unlockDate DateTime? // For DRIP schedules

  @@unique([batchId, stepId])
}

model BatchAnnouncement {
  id             String   @id @default(uuid())
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("SentAnnouncements", fields: [senderId], references: [id])
  title          String
  message        String
  sendEmail      Boolean  @default(true)
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([batchId, createdAt])
  @@index([senderId])
}

// Step-level progression tracking
model StepProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepId      String
  step        Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  isUnlocked Boolean   @default(false)
  unlockedAt DateTime?

  overrideState  StepOverrideState @default(AUTOMATIC)
  overrideReason String?
  overriddenById String?
  overriddenAt   DateTime?

  score Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, stepId])
  @@index([enrolmentId])
  @@index([stepId])
  @@index([enrolmentId, isCompleted])
  @@index([enrolmentId, overrideState])
  @@index([overriddenById])
}

// -----------------------------------------------------------------------------
// SYNCHRONOUS OPERATIONS (SESSIONS, BOOKINGS & ATTENDANCE)
// -----------------------------------------------------------------------------

model Session {
  id String @id @default(uuid())

  // Scoping & Relations
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  learnerId String? // For dedicated 1:1 sessions
  learner   User?   @relation("Learner1on1Sessions", fields: [learnerId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("UserSpecificSessions", fields: [userId], references: [id], onDelete: SetNull)

  hostTrainerId String?
  hostTrainer   User?   @relation("HostTrainerSessions", fields: [hostTrainerId], references: [id], onDelete: SetNull)

  // Scheduling & Timing
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int?     // Duration in minutes
  timezone        String?  @default("UTC") // Timezone-aware scheduling

  // Lifecycle & Capacity
  sessionType SessionType   @default(GROUP_COHORT)
  status      SessionStatus @default(SCHEDULED)
  capacity    Int? // Maximum booking capacity (e.g. 1 for 1:1, or cohort size)
  isRequired  Boolean       @default(true) // Indicates if this session counts towards compliance

  // Meeting Provider Metadata (Provider-Neutral)
  meetingProvider      MeetingProvider @default(ZOOM)
  providerMeetingId    String? // Provider-neutral meeting ID
  externalMeetingId    String? // Canonical external meeting ID
  zoomMeetingId        String? // Preserved for backward compatibility
  joinUrl              String? // Learner/attendee join URL
  meetingLink          String? // Alias for meeting link
  hostUrl              String? // Host start/join URL
  recordingUrl         String? // Final recording URL
  recordingLink        String? // Canonical recording link
  providerRecordingUrl String? // Raw provider cloud recording URL
  checkinTokenSecret   String? // Secret token for in-person QR/link check-in

  // Agenda & Assessment References
  agenda String?
  quizId String?

  // Rescheduling & Cancellation Audit
  cancelledAt     DateTime?
  cancelReason    String?
  rescheduledToId String?
  rescheduledTo   Session?  @relation("RescheduledSessions", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Session[] @relation("RescheduledSessions")

  // Attendance & Booking Relations (Historical records protected via Restrict)
  attendancePulled     Boolean               @default(false)
  attendances          Attendance[]
  unmatchedAttendances UnmatchedAttendance[]
  bookings             SessionBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, startTime])
  @@index([startTime])
  @@index([status])
  @@index([hostTrainerId])
  @@index([learnerId])
  @@index([userId])
  @@index([learnerId, startTime(sort: Desc)])
  @@index([hostTrainerId, startTime(sort: Desc)])
  @@index([batchId, sessionType, startTime])
  @@index([zoomMeetingId])
  @@index([providerMeetingId])
  @@index([externalMeetingId])
}

model SessionBooking {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("UserSessionBookings", fields: [userId], references: [id], onDelete: Cascade)

  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  status BookingStatus @default(BOOKED)

  // Rescheduling & Cancellation Audit
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([enrolmentId])
  @@index([userId, status])
  @@index([sessionId, status])
  @@index([createdAt(sort: Desc)])
}

model Attendance {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(ABSENT)
  source AttendanceSource @default(AUTO)

  joinTime             DateTime?
  leaveTime            DateTime?
  durationMin          Int?
  minutesPresent       Int?
  attendancePercentage Float?

  overrideReason   String?
  correctionReason String?
  correctedById    String?
  correctedBy      User?   @relation("CorrectedAttendances", fields: [correctedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId, enrolmentId])
  @@index([userId])
  @@index([status])
  @@index([enrolmentId])
  @@index([enrolmentId, status])
  @@index([userId, status])
  @@index([correctedById])
}

// -----------------------------------------------------------------------------
// UNMATCHED ATTENDANCE
// -----------------------------------------------------------------------------

enum UnmatchedAttendanceStatus {
  UNMATCHED
  LINKED
  IGNORED
}

model UnmatchedAttendance {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  provider         String
  providerId       String?
  participantEmail String?
  participantName  String?

  joinTime       DateTime?
  leaveTime      DateTime?
  durationMin    Int?
  minutesPresent Int?
  rawPayload     Json?

  status UnmatchedAttendanceStatus @default(UNMATCHED)

  linkedEnrolmentId String?
  linkedEnrolment   Enrolment? @relation(fields: [linkedEnrolmentId], references: [id], onDelete: SetNull)

  linkedUserId String?
  linkedUser   User?   @relation("LinkedUnmatchedAttendances", fields: [linkedUserId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?     @relation("ResolvedUnmatchedAttendances", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status])
  @@index([participantEmail])
  @@index([sessionId, joinTime(sort: Asc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([linkedEnrolmentId])
  @@index([linkedUserId])
  @@index([resolvedById])
}

// -----------------------------------------------------------------------------
// PAYMENTS & CERTIFICATIONS
// -----------------------------------------------------------------------------

// One row per learner per calendar day they were active. A day counts as
// present when any flag is set: they opened the portal or signed in, finished
// a course step, or joined a live session.
model DailyAttendance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          String // YYYY-MM-DD in the attendance time zone
  visited       Boolean @default(false)
  lessonDone    Boolean @default(false)
  sessionJoined Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model Payment {
  id          String     @id @default(uuid())
  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  eventRegistrationId String?
  idempotencyKey String? @unique
  invoice     Invoice?

  stripeSessionId String @unique
  amount          Float
  currency        String @default("USD")
  status          String // e.g., 'succeeded', 'failed', 'pending'

  couponId        String?
  couponCode      String?
  discountAmount  Float?
  redemptions     CouponRedemption[]

  createdAt DateTime @default(now())

  @@index([enrolmentId])
  @@index([eventRegistrationId])
  @@index([status, createdAt(sort: Desc)])
  @@index([couponId])
}

model Certificate {
  id String @id @default(uuid())

  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("UserCertificates", fields: [userId], references: [id], onDelete: Restrict)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  certificateCode   String  @unique @default(uuid())
  certificateNumber String? @unique // Legacy compatibility with existing services
  verificationHash  String?

  issueDate DateTime?
  issuedAt  DateTime? // Legacy compatibility with existing services

  approvedById String?
  approvedBy   User?     @relation("ApprovedCertificates", fields: [approvedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  cpdHours     Int?

  certificateType CertificateType   @default(PROFESSIONAL)
  status          CertificateStatus @default(PENDING)
  pdfUrl          String? // Storage key/URL for generated certificate PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([programId])
  @@index([status])
  @@index([certificateCode])
  @@index([approvedById])
  @@index([createdAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// COMMUNICATIONS (CHAT)
// -----------------------------------------------------------------------------

model Conversation {
  id             String             @id @default(uuid())
  participantIds String[] // Store UUIDs of participants
  status         ConversationStatus @default(OPEN)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([updatedAt(sort: Desc)])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content       String
  attachmentUrl String?
  read          Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, read])
  @@index([senderId])
}

// -----------------------------------------------------------------------------
// MISSING PRD ENTITIES (INVOICE, COUPON, AGREEMENT, NOTIFICATION, AUDIT, LEAD)
// -----------------------------------------------------------------------------

model Invoice {
  id        String   @id @default(uuid())
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  enrolmentId String?
  eventRegistrationId String?

  invoiceNumber String        @unique
  amount        Float
  currency      String        @default("USD")
  couponCode    String?
  discountAmount Float?
  taxFields     Json?
  pdfUrl        String?
  status        InvoiceStatus @default(DRAFT)
  creditNoteId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([creditNoteId])
  @@index([enrolmentId])
  @@index([eventRegistrationId])
}

model Coupon {
  id                    String             @id @default(uuid())
  code                  String             @unique
  description           String?
  discountType          CouponDiscountType @default(PERCENTAGE)
  discountValue         Float
  currency              CouponCurrency     @default(ALL)
  scope                 CouponScope        @default(ALL_COURSES)

  maxTotalUses          Int?
  currentUses           Int                @default(0)
  maxUsesPerUser        Int                @default(1)

  validFrom             DateTime           @default(now())
  expiresAt             DateTime?
  isActive              Boolean            @default(true)

  stripeCouponId        String?
  stripePromotionCodeId String?
  appliesToInstalments  Boolean            @default(false)

  programs              Program[]          @relation("CouponPrograms")
  redemptions           CouponRedemption[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([isActive, expiresAt])
  @@index([createdAt(sort: Desc)])
  @@index([discountType])
}

model CouponRedemption {
  id             String     @id @default(uuid())
  couponId       String
  coupon         Coupon     @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrolmentId    String?
  enrolment      Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  paymentId      String?
  payment        Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  orderAmount    Float
  discountAmount Float
  finalAmount    Float
  currency       String     @default("USD")

  redeemedAt     DateTime   @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([couponId, redeemedAt(sort: Desc)])
  @@index([enrolmentId])
  @@index([paymentId])
  @@index([redeemedAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// AGREEMENTS (TEMPLATES & SIGNED AGREEMENTS)
// -----------------------------------------------------------------------------

model AgreementTemplate {
  id          String  @id @default(uuid())
  title       String
  description String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  versions         AgreementTemplateVersion[]
  signedAgreements SignedAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model AgreementTemplateVersion {
  id         String            @id @default(uuid())
  templateId String
  template   AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version     String // e.g. "v1.0", "v2.0"
  content     String // Agreement body/terms for rendering and PDF generation
  changelog   String? // Summary of changes from previous version
  status      ContentStatus @default(DRAFT) // DRAFT, PUBLISHED, ARCHIVED
  publishedAt DateTime?
  createdById String?
  createdBy   User?         @relation("CreatedAgreementVersions", fields: [createdById], references: [id], onDelete: SetNull)

  signedAgreements SignedAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([templateId, createdAt(sort: Desc)])
  @@index([createdById])
}

model SignedAgreement {
  id          String    @id @default(uuid())
  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  templateId String
  template   AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  versionId String
  version   AgreementTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  templateVersion  String // Immutable snapshot of version string at signing (e.g. "v1.0")
  consentVersion   String? // Version of consent statement accepted
  consentGiven     Boolean         @default(false) // Explicit read & consent tick
  consentTimestamp DateTime? // Timestamp when explicit consent was recorded
  typedName        String? // Typed full name signature
  drawnSignature   String? // Drawn signature data URL or uploaded signature data/storage pointer
  signatureType    String?         @default("DRAWN") // "DRAWN" or "UPLOADED"
  signerIp         String? // Signer IP address
  userAgent        String? // Signer User-Agent
  signedPdfUrl     String? // Provider-neutral storage reference/URL to generated signed PDF
  status           AgreementStatus @default(PENDING)
  signedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([programId])
  @@index([templateId])
  @@index([versionId])
  @@index([status])
  @@index([templateId, signedAt(sort: Desc)])
  @@index([userId, status])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String?
  message        String?
  link           String?
  readAt         DateTime?
  metadata       Json?

  type           String
  template       String
  channel        NotificationChannel @default(EMAIL)
  schedule       DateTime?
  deliveryStatus DeliveryStatus      @default(QUEUED)
  sentAt         DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([deliveryStatus, schedule])
  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id       String  @id @default(uuid())
  actorId  String? // Can be null if system action
  action   String
  entity   String
  entityId String
  meta     Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action, createdAt(sort: Desc)])
}

model Lead {
  id      String     @id @default(uuid())
  name    String
  email   String
  phone   String?
  message String?
  status  LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([email])
}

enum CertificateStatus {
  ELIGIBLE
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

// -----------------------------------------------------------------------------
// EMAIL DELIVERY
// -----------------------------------------------------------------------------

model EmailDeliveryLog {
  id         String         @id @default(uuid())
  to         String
  subject    String
  template   String?
  status     DeliveryStatus @default(QUEUED)
  providerId String? // E.g. Resend ID
  error      String?
  html       String? // Useful for local dev / debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([to])
  @@index([status])
}

// -----------------------------------------------------------------------------
// RELIABILITY & OUTBOX
// -----------------------------------------------------------------------------

model OutboxEvent {
  id         String       @id @default(uuid())
  type       String // e.g., "sync-meeting"
  action     String // e.g., "CREATE", "UPDATE", "CANCEL"
  payload    Json? // Job payload
  status     OutboxStatus @default(PENDING)
  providerId String? // Used for idempotency (e.g., storing Zoom Meeting ID temporarily)
  error      String?
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -----------------------------------------------------------------------------
// EVENTS & WEBINARS
// -----------------------------------------------------------------------------

enum EventType {
  EVENT
  WEBINAR
}

enum EventStatus {
  SCHEDULED
  REGISTRATION_OPEN
  ONGOING
  ENDED
  CANCELLED
}

enum EventLocationType {
  ONLINE
  PHYSICAL
}

enum CurrencyCode {
  USD
  AED
  INR
}

enum EventPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Event {
  id              String              @id @default(uuid())
  title           String
  slug            String              @unique
  description     String              @db.Text
  bannerUrl       String?
  startDateTime   DateTime
  endDateTime     DateTime?
  timezone        String              @default("UTC")
  
  // Online vs Physical Toggle
  locationType    EventLocationType   @default(ONLINE)
  meetingLink     String?             // Required if ONLINE (kept private until paid)
  venueName       String?             // Required if PHYSICAL (e.g., Hall Name)
  venueAddress    String?             // Required if PHYSICAL (Full address / Map link)
  
  // Dynamic Pricing & Multi-Currency
  price           Decimal             @default(0.00) @db.Decimal(10, 2)
  currency        CurrencyCode        @default(USD)
  seatLimit       Int?                // Null = unlimited seats
  seatsBooked     Int                 @default(0)
  
  isPublished     Boolean             @default(true)
  createdById     String?
  createdBy       User?               @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  registrations   EventRegistration[]

  @@index([locationType, isPublished])
  @@index([startDateTime])
  @@index([createdAt])
}

model EventRegistration {
  id                String             @id @default(uuid())
  eventId           String
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String?            // Optional if guest checkout is allowed, or linked to User
  user              User?              @relation("UserEventRegistrations", fields: [userId], references: [id], onDelete: SetNull)
  
  attendeeName      String
  attendeeEmail     String
  attendeePhone     String
  
  amount            Decimal            @default(0.00) @db.Decimal(10, 2)
  currency          CurrencyCode       @default(USD)
  paymentGateway    String             @default("SIMULATION") // "RAZORPAY" | "STRIPE" | "SIMULATION" | "FREE"
  gatewayOrderId    String?            @unique
  gatewayPaymentId  String?
  paymentStatus     EventPaymentStatus @default(PENDING)
  
  emailSent         Boolean            @default(false)
  registeredAt      DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  rejectedById      String?
  rejectedBy        User?              @relation("RejectedEventRegistrations", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason   String?

  @@index([eventId, paymentStatus])
  @@index([attendeeEmail])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// PHOTO GALLERY (COURSES & CONFERENCES SHOWCASE)
// -----------------------------------------------------------------------------

model GalleryItem {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(160) // e.g., "Attended Research Course at US"
  description  String?  @db.Text         // Context about the course/conference photo
  imageUrl     String                    // Uploaded image URL (WebP/AVIF/JPEG/PNG)
  altText      String?  @db.VarChar(200) // Accessibility fallback (defaults to title)
  category     String?  @db.VarChar(60)  // Optional tag: "Course", "Conference", "Workshop"
  displayOrder Int      @default(0)      // Controls sort order on the user website
  isPublished  Boolean  @default(true)   // Allows Admin to hide/show without deleting
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder, createdAt(sort: Desc)])
}

