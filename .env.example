# -------------------------------------------------------------
# DATABASE (Neon PostgreSQL / Free-Tier Pooled DB)
# -------------------------------------------------------------
# Pooled connection string with PgBouncer enabled for serverless API & high-concurrency requests:
DATABASE_URL="postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=15"
# Direct connection string for Prisma migrations, DDL statements, and advisory locks:
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Database Connection Pool Sizing for Free-Tier limits (prevent connection exhaustion)
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=15
DB_PGBOUNCER=true

# -------------------------------------------------------------
# BACKEND API & SERVICE URLS
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_LMS_URL="http://localhost:3003"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+91 7899447024"
PORT=4000
PAYMENT_MODE="mock"
PAYMENT_PROVIDER="STRIPE"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# -------------------------------------------------------------
# AUTHENTICATION (JWT)
# -------------------------------------------------------------
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# -------------------------------------------------------------
# CLOUDINARY MEDIA
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Zoom Integration (S2S OAuth)
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"
ZOOM_WEBHOOK_SECRET_TOKEN="your_zoom_webhook_secret"

# -------------------------------------------------------------
# REDIS / VALKEY (Standard Redis for Caching, BullMQ, Rate Limiter)
# -------------------------------------------------------------
# Supports standard redis:// or TLS rediss://
REDIS_URL="redis://localhost:6379"
# Optional host/port fallback if REDIS_URL is not set:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
