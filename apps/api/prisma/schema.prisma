generator client {
  provider        = "prisma-client-js"
  // nested relations load in a single joined query instead of one query per
  // level; each query is a round trip to a distant database
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TEACHER
  USER
}

enum EnrolmentStatus {
  PENDING_PAYMENT
  PENDING_AGREEMENT
  ACTIVE
  WAITLIST
  COMPLETED
  REVOKED
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  SHORT_ANSWER
}

enum OralAssessmentStatus {
  SCHEDULED
  IN_PROGRESS
  PASSED
  FAILED
  CANCELLED
}

enum ContentType {
  VIDEO
  PDF
  AUDIO
  TEXT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReleaseSchedule {
  IMMEDIATE
  BATCH_SCHEDULED
}

enum StepOverrideState {
  AUTOMATIC
  MANUAL_UNLOCKED
  MANUAL_LOCKED
}

enum ResourceType {
  VIEW_ONLY_PDF
  DOWNLOADABLE_WORKSHEET
  STREAMABLE_AUDIO
}

enum ResourceScope {
  STEP_SPECIFIC
  PROGRAM_LIBRARY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AgreementStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SessionType {
  WELCOME_CALL_11_STEPS
  CLOSING_CALL_11_STEPS
  ONE_ON_ONE_WITH_RO
  VISION_BOARD_WORKSHOP
  VISION_BOARD_ONLINE
  SPEAKER_DISCOVERY_CALL
  BATCH_CLASS
  GROUP_COHORT
  ONE_ON_ONE
}

enum MeetingProvider {
  ZOOM
  GOOGLE_MEET
  IN_PERSON
  MANUAL
}

enum BookingStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  ATTENDED
  NO_SHOW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  PENDING
  PRESENT_AUTO
  PRESENT_MANUAL
  CORRECTED
}

enum AttendanceSource {
  AUTO
  MANUAL
  QR_CHECKIN
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum CertificateType {
  PROFESSIONAL
  CORPORATE_PARTICIPATION
}

enum NotificationChannel {
  EMAIL
  IN_APP
  BOTH
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  REOPENED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES (USERS & COMPANIES)
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  phone        String?
  passwordHash String?
  role         Role    @default(USER)
  permissions  String[] @default([])

  // Authentication & Security (D1-004)
  country              String?
  timezone             String?
  emailVerifiedAt      DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String[]  @default([])

  // Relations
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  managedBatches               Batch[]                    @relation("ManagerBatches")
  batchTrainers                BatchTrainer[]             @relation("BatchTrainers")
  oralAssessmentsAssessed      OralAssessment[]           @relation("AssessorOralAssessments")
  signedAgreements             SignedAgreement[]
  createdAgreementVersions     AgreementTemplateVersion[] @relation("CreatedAgreementVersions")
  sessionBookings              SessionBooking[]           @relation("UserSessionBookings")
  attendedSessions             Attendance[]               @relation("UserAttendances")
  correctedAttendances         Attendance[]               @relation("CorrectedAttendances")
  resolvedUnmatchedAttendances UnmatchedAttendance[]      @relation("ResolvedUnmatchedAttendances")
  linkedUnmatchedAttendances   UnmatchedAttendance[]      @relation("LinkedUnmatchedAttendances")
  learnerSessions              Session[]                  @relation("Learner1on1Sessions")
  userSpecificSessions         Session[]                  @relation("UserSpecificSessions")
  hostedSessions               Session[]                  @relation("HostTrainerSessions")
  certificates                 Certificate[]              @relation("UserCertificates")
  approvedCertificates         Certificate[]              @relation("ApprovedCertificates")
  enrolments                   Enrolment[]
  messagesSent                 Message[]
  sessions                     UserSession[]
  notifications                Notification[]
  dailyAttendance              DailyAttendance[]
  emailVerificationTokens      EmailVerificationToken[]
  passwordResetTokens          PasswordResetToken[]
  otpCodes                     OtpCode[]
  loginAudits                  LoginAudit[]

  // Soft Delete for GDPR
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([companyId])
}

model UserSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token             String    @unique // Store the JWT or a session hash
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  lastActive        DateTime  @default(now())
  expiresAt         DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model LoginAudit {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress         String?
  userAgent         String?
  country           String?
  deviceFingerprint String?
  isSuspicious      Boolean  @default(false)
  reason            String?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// CURRICULUM (PROGRAMS, STEPS, LESSONS, QUIZZES)
// -----------------------------------------------------------------------------

model Program {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  price       Float
  isActive    Boolean       @default(true)
  status      ContentStatus @default(DRAFT)

  hasCertificate          Boolean       @default(false)
  certificateTemplate     String?
  attendanceThreshold     Int           @default(80)
  attendanceRequired      Boolean       @default(true)
  minAttendancePercentage Int           @default(75)
  deliveryMode            DeliveryMode  @default(ONLINE)

  steps              Step[]
  batches            Batch[]
  resources          Resource[]
  enrolments         Enrolment[]
  questionBanks      QuestionBank[]
  exams              Exam[]
  oralAssessments    OralAssessment[]
  agreementTemplates AgreementTemplate[]
  signedAgreements   SignedAgreement[]
  certificates       Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Step {
  id        String  @id @default(uuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  sequence    Int // 1 to 11
  title       String
  description String?
  status      ContentStatus @default(DRAFT)

  releaseSchedule ReleaseSchedule @default(IMMEDIATE)
  unlockDelayDays Int?

  lessons       Lesson[]
  resources     Resource[]
  quiz          Quiz?
  questionBanks QuestionBank[]
  questions     Question[]
  overrides     BatchStepOverride[]
  progress      StepProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, sequence])
  @@index([programId, sequence])
}

model Lesson {
  id     String @id @default(uuid())
  stepId String
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  title       String
  type        ContentType
  mediaUrl    String // AWS S3 / Mux Asset ID
  durationSec Int?
  content     String? // For TEXT content or lesson notes
  order       Int           @default(1)
  status      ContentStatus @default(DRAFT)

  progress UserLessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId, order])
}

model Resource {
  id          String        @id @default(uuid())
  title       String
  description String?
  type        ResourceType
  scope       ResourceScope @default(STEP_SPECIFIC)
  mediaUrl    String // Cloudinary / Object Storage URL
  fileSize    Int? // File size in bytes
  mimeType    String? // MIME type e.g. application/pdf, audio/mpeg
  status      ContentStatus @default(PUBLISHED)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([stepId])
  @@index([batchId])
}

// -----------------------------------------------------------------------------
// ASSESSMENTS (QUESTION BANKS, QUIZZES, EXAMS, ORAL ASSESSMENTS)
// -----------------------------------------------------------------------------

model QuestionBank {
  id          String  @id @default(uuid())
  title       String
  description String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([stepId])
}

model Question {
  id          String       @id @default(uuid())
  type        QuestionType @default(MULTIPLE_CHOICE)
  text        String
  explanation String?
  points      Int          @default(1)

  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)

  quizId String?
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  stepId String?
  step   Step?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  options Option[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionBankId])
  @@index([quizId])
  @@index([stepId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model Quiz {
  id     String @id @default(uuid())
  stepId String @unique
  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  title         String?
  passMark      Int     @default(75) // Percentage required to pass
  maxAttempts   Int     @default(3) // Throttling / retry limit
  cooldownHours Int     @default(24) // Wait between retries
  questionCount Int     @default(10) // 10-question step quiz requirement
  timeLimitMin  Int?
  retryGuidance String?

  questions Question[]
  attempts  Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id          String  @id @default(uuid())
  title       String
  description String?
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  questionCount    Int           @default(50) // 50 questions pooled from question bank
  passMark         Int           @default(75) // Percentage required to pass
  timeLimitMin     Int           @default(90) // Configurable default: 90 minutes
  shuffleQuestions Boolean       @default(true)
  maxAttempts      Int           @default(3)
  cooldownHours    Int           @default(24)
  retryGuidance    String?
  status           ContentStatus @default(DRAFT)

  attempts ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model ExamAttempt {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Restrict)

  attemptNumber Int           @default(1)
  score         Int?
  passed        Boolean?
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  answers       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, examId, attemptNumber])
  @@index([enrolmentId, examId])
  @@index([examId, status])
}

model OralAssessment {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  programId   String
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  sessionId     String?
  assessorId    String?
  assessor      User?                @relation("AssessorOralAssessments", fields: [assessorId], references: [id], onDelete: SetNull)
  status        OralAssessmentStatus @default(SCHEDULED)
  overallScore  Int?
  passed        Boolean?
  scheduledDate DateTime?
  completedAt   DateTime?
  trainerNotes  String?
  retryGuidance String?

  scores OralAssessmentScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrolmentId])
  @@index([programId])
  @@index([assessorId])
}

model OralAssessmentScore {
  id             String         @id @default(uuid())
  assessmentId   String
  assessment     OralAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  rubricCategory String
  score          Int
  maxScore       Int            @default(10)
  feedback       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
}

// -----------------------------------------------------------------------------
// ENROLMENT & BATCH MANAGEMENT
// -----------------------------------------------------------------------------

model Batch {
  id        String  @id @default(uuid())
  name      String
  programId String
  program   Program @relation(fields: [programId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerBatches", fields: [managerId], references: [id])

  startDate           DateTime
  endDate             DateTime?
  capacity            Int
  status              BatchStatus @default(UPCOMING)
  attendanceThreshold Int?

  enrolments    Enrolment[]
  sessions      Session[]
  overrides     BatchStepOverride[]
  trainers      BatchTrainer[]
  resources     Resource[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId, status])
  @@index([managerId, status])
}

model BatchTrainer {
  id        String @id @default(uuid())
  batchId   String
  batch     Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User   @relation("BatchTrainers", fields: [trainerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([batchId, trainerId])
  @@index([trainerId])
  @@index([batchId])
}

model Enrolment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  status EnrolmentStatus @default(PENDING_PAYMENT)

  signedAgreement SignedAgreement?

  attempts             Attempt[]
  examAttempts         ExamAttempt[]
  oralAssessments      OralAssessment[]
  lessonProgress       UserLessonProgress[]
  attendance           Attendance[]
  unmatchedAttendances UnmatchedAttendance[]
  sessionBookings      SessionBooking[]
  certificate          Certificate?
  payments             Payment[]
  stepProgress         StepProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
  @@unique([userId, batchId])
  @@index([userId, status])
  @@index([batchId, status])
}

// -----------------------------------------------------------------------------
// PROGRESSION TRACKING & LOGIC GATES
// -----------------------------------------------------------------------------

// TRD 2.2: Tracks video view logic
model UserLessonProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  viewed          Boolean   @default(false)
  progressPercent Float     @default(0)
  lastPositionSec Float?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, lessonId])
  @@index([enrolmentId, viewed])
  @@index([lessonId])
}

// TRD 2.2: The attempt state machine for Quizzes
model Attempt {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Restrict)

  attemptNumber Int           @default(1)
  score         Int?
  passed        Boolean?
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, quizId, attemptNumber])
  @@index([enrolmentId, quizId])
  @@index([quizId, status])
  @@index([enrolmentId, status])
}

model QuizAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  selectedOptionId  String?
  selectedOptionIds String[] @default([])
  textAnswer        String?
  isCorrect         Boolean  @default(false)
  pointsAwarded     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// TRD 2.2: Admin override logic for locking/unlocking steps manually
model BatchStepOverride {
  id      String @id @default(uuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stepId  String
  step    Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  isUnlocked Boolean   @default(false)
  unlockDate DateTime? // For DRIP schedules

  @@unique([batchId, stepId])
}

// Step-level progression tracking
model StepProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepId      String
  step        Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  isUnlocked Boolean   @default(false)
  unlockedAt DateTime?

  overrideState  StepOverrideState @default(AUTOMATIC)
  overrideReason String?
  overriddenById String?
  overriddenAt   DateTime?

  score Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrolmentId, stepId])
  @@index([enrolmentId])
  @@index([stepId])
  @@index([enrolmentId, isCompleted])
  @@index([enrolmentId, overrideState])
}

// -----------------------------------------------------------------------------
// SYNCHRONOUS OPERATIONS (SESSIONS, BOOKINGS & ATTENDANCE)
// -----------------------------------------------------------------------------

model Session {
  id String @id @default(uuid())

  // Scoping & Relations
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  learnerId String? // For dedicated 1:1 sessions
  learner   User?   @relation("Learner1on1Sessions", fields: [learnerId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("UserSpecificSessions", fields: [userId], references: [id], onDelete: SetNull)

  hostTrainerId String?
  hostTrainer   User?   @relation("HostTrainerSessions", fields: [hostTrainerId], references: [id], onDelete: SetNull)

  // Scheduling & Timing
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int?     // Duration in minutes
  timezone        String?  @default("UTC") // Timezone-aware scheduling

  // Lifecycle & Capacity
  sessionType SessionType   @default(GROUP_COHORT)
  status      SessionStatus @default(SCHEDULED)
  capacity    Int? // Maximum booking capacity (e.g. 1 for 1:1, or cohort size)
  isRequired  Boolean       @default(true) // Indicates if this session counts towards compliance

  // Meeting Provider Metadata (Provider-Neutral)
  meetingProvider      MeetingProvider @default(ZOOM)
  providerMeetingId    String? // Provider-neutral meeting ID
  externalMeetingId    String? // Canonical external meeting ID
  zoomMeetingId        String? // Preserved for backward compatibility
  joinUrl              String? // Learner/attendee join URL
  meetingLink          String? // Alias for meeting link
  hostUrl              String? // Host start/join URL
  recordingUrl         String? // Final recording URL
  recordingLink        String? // Canonical recording link
  providerRecordingUrl String? // Raw provider cloud recording URL
  checkinTokenSecret   String? // Secret token for in-person QR/link check-in

  // Agenda & Assessment References
  agenda String?
  quizId String?

  // Rescheduling & Cancellation Audit
  cancelledAt     DateTime?
  cancelReason    String?
  rescheduledToId String?
  rescheduledTo   Session?  @relation("RescheduledSessions", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom Session[] @relation("RescheduledSessions")

  // Attendance & Booking Relations (Historical records protected via Restrict)
  attendancePulled     Boolean               @default(false)
  attendances          Attendance[]
  unmatchedAttendances UnmatchedAttendance[]
  bookings             SessionBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, startTime])
  @@index([startTime])
  @@index([status])
  @@index([hostTrainerId])
  @@index([learnerId])
  @@index([userId])
}

model SessionBooking {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("UserSessionBookings", fields: [userId], references: [id], onDelete: Cascade)

  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  status BookingStatus @default(BOOKED)

  // Rescheduling & Cancellation Audit
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([enrolmentId])
}

model Attendance {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(ABSENT)
  source AttendanceSource @default(AUTO)

  joinTime             DateTime?
  leaveTime            DateTime?
  durationMin          Int?
  minutesPresent       Int?
  attendancePercentage Float?

  overrideReason   String?
  correctionReason String?
  correctedById    String?
  correctedBy      User?   @relation("CorrectedAttendances", fields: [correctedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId, enrolmentId])
  @@index([userId])
  @@index([status])
  @@index([enrolmentId])
}

// -----------------------------------------------------------------------------
// UNMATCHED ATTENDANCE
// -----------------------------------------------------------------------------

enum UnmatchedAttendanceStatus {
  UNMATCHED
  LINKED
  IGNORED
}

model UnmatchedAttendance {
  id String @id @default(uuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  provider         String
  providerId       String?
  participantEmail String?
  participantName  String?

  joinTime       DateTime?
  leaveTime      DateTime?
  durationMin    Int?
  minutesPresent Int?
  rawPayload     Json?

  status UnmatchedAttendanceStatus @default(UNMATCHED)

  linkedEnrolmentId String?
  linkedEnrolment   Enrolment? @relation(fields: [linkedEnrolmentId], references: [id], onDelete: SetNull)

  linkedUserId String?
  linkedUser   User?   @relation("LinkedUnmatchedAttendances", fields: [linkedUserId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?     @relation("ResolvedUnmatchedAttendances", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status])
  @@index([participantEmail])
}

// -----------------------------------------------------------------------------
// PAYMENTS & CERTIFICATIONS
// -----------------------------------------------------------------------------

// One row per learner per calendar day they were active. A day counts as
// present when any flag is set: they opened the portal or signed in, finished
// a course step, or joined a live session.
model DailyAttendance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          String // YYYY-MM-DD in the attendance time zone
  visited       Boolean @default(false)
  lessonDone    Boolean @default(false)
  sessionJoined Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Payment {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  stripeSessionId String @unique
  amount          Float
  currency        String @default("USD")
  status          String // e.g., 'succeeded', 'failed'

  createdAt DateTime @default(now())
}

model Certificate {
  id String @id @default(uuid())

  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("UserCertificates", fields: [userId], references: [id], onDelete: Restrict)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  certificateCode   String  @unique @default(uuid())
  certificateNumber String? @unique // Legacy compatibility with existing services
  verificationHash  String?

  issueDate DateTime?
  issuedAt  DateTime? // Legacy compatibility with existing services

  approvedById String?
  approvedBy   User?     @relation("ApprovedCertificates", fields: [approvedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  cpdHours     Int?

  certificateType CertificateType   @default(PROFESSIONAL)
  status          CertificateStatus @default(PENDING)
  pdfUrl          String? // Storage key/URL for generated certificate PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([programId])
  @@index([status])
  @@index([certificateCode])
}

// -----------------------------------------------------------------------------
// COMMUNICATIONS (CHAT)
// -----------------------------------------------------------------------------

model Conversation {
  id             String             @id @default(uuid())
  participantIds String[] // Store UUIDs of participants
  status         ConversationStatus @default(OPEN)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([batchId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content       String
  attachmentUrl String?
  read          Boolean @default(false)

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// MISSING PRD ENTITIES (INVOICE, COUPON, AGREEMENT, NOTIFICATION, AUDIT, LEAD)
// -----------------------------------------------------------------------------

model Invoice {
  id        String  @id @default(uuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceNumber String        @unique
  amount        Float
  currency      String        @default("USD")
  taxFields     Json?
  pdfUrl        String?
  status        InvoiceStatus @default(DRAFT)
  creditNoteId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id         String     @id @default(uuid())
  code       String     @unique
  type       CouponType
  value      Float
  usageLimit Int?
  usedCount  Int        @default(0)
  expiryDate DateTime?

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// AGREEMENTS (TEMPLATES & SIGNED AGREEMENTS)
// -----------------------------------------------------------------------------

model AgreementTemplate {
  id          String  @id @default(uuid())
  title       String
  description String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  versions         AgreementTemplateVersion[]
  signedAgreements SignedAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model AgreementTemplateVersion {
  id         String            @id @default(uuid())
  templateId String
  template   AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version     String // e.g. "v1.0", "v2.0"
  content     String // Agreement body/terms for rendering and PDF generation
  changelog   String? // Summary of changes from previous version
  status      ContentStatus @default(DRAFT) // DRAFT, PUBLISHED, ARCHIVED
  publishedAt DateTime?
  createdById String?
  createdBy   User?         @relation("CreatedAgreementVersions", fields: [createdById], references: [id], onDelete: SetNull)

  signedAgreements SignedAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, version])
  @@index([templateId, status])
}

model SignedAgreement {
  id          String    @id @default(uuid())
  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  templateId String
  template   AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  versionId String
  version   AgreementTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  templateVersion String // Immutable snapshot of version string at signing (e.g. "v1.0")
  consentGiven    Boolean         @default(false) // Explicit read & consent tick
  typedName       String? // Typed full name signature
  drawnSignature  String? // Drawn signature data URL or storage pointer
  signerIp        String? // Signer IP address
  userAgent       String? // Signer User-Agent
  signedPdfUrl    String? // Provider-neutral storage reference/URL to generated signed PDF
  status          AgreementStatus @default(PENDING)
  signedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([programId])
  @@index([templateId])
  @@index([versionId])
  @@index([status])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String
  template       String
  channel        NotificationChannel @default(EMAIL)
  schedule       DateTime?
  deliveryStatus DeliveryStatus      @default(QUEUED)
  sentAt         DateTime?

  createdAt DateTime @default(now())
}

model AuditLog {
  id       String  @id @default(uuid())
  actorId  String? // Can be null if system action
  action   String
  entity   String
  entityId String
  meta     Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Lead {
  id      String     @id @default(uuid())
  name    String
  email   String
  phone   String?
  message String?
  status  LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CertificateStatus {
  ELIGIBLE
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

// -----------------------------------------------------------------------------
// EMAIL DELIVERY
// -----------------------------------------------------------------------------

model EmailDeliveryLog {
  id         String         @id @default(uuid())
  to         String
  subject    String
  template   String?
  status     DeliveryStatus @default(QUEUED)
  providerId String? // E.g. Resend ID
  error      String?
  html       String? // Useful for local dev / debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([to])
  @@index([status])
}

// -----------------------------------------------------------------------------
// RELIABILITY & OUTBOX
// -----------------------------------------------------------------------------

model OutboxEvent {
  id         String       @id @default(uuid())
  type       String // e.g., "sync-meeting"
  action     String // e.g., "CREATE", "UPDATE", "CANCEL"
  payload    Json? // Job payload
  status     OutboxStatus @default(PENDING)
  providerId String? // Used for idempotency (e.g., storing Zoom Meeting ID temporarily)
  error      String?
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
